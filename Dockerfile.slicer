# Hosted slicing server. Build: docker build -f Dockerfile.slicer -t hyphi-slicer .
# Run:   docker run -p 8787:8787 -e SLICER_API_KEYS=<secret> -e SLICER_CORS_ORIGINS=https://your-app.example hyphi-slicer
# Terminate TLS at your ingress / reverse proxy. To add the PrusaSlicer engine, install it in an extra layer and set PRUSA_SLICER.
FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci --omit=dev --workspaces --include-workspace-root --ignore-scripts
COPY scripts ./scripts
COPY slicer-profiles ./slicer-profiles
COPY src/facetfold/lib/kernel.js ./src/facetfold/lib/kernel.js
ENV CONTAINER=1 PORT=8787 NODE_ENV=production
USER node
EXPOSE 8787
HEALTHCHECK CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "scripts/slice-server.mjs"]
